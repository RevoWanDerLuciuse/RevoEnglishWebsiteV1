# Settings for compose.prod.yaml. Copy to .env on the server (`cp .env.example .env`) and fill in.
# .env is git-ignored: it holds secrets and survives `git pull`.

# Database password, chosen once. Generate one with: openssl rand -base64 24
# Changing it later does not change the password of an existing database.
DB_PASSWORD=

# Public address of the site, e.g. https://your-domain.example. While empty, search engines are asked not to index it.
SITE_BASE_URL=

# Telegram username for all contact buttons.
SITE_TELEGRAM_USERNAME=RevoWanDerLuciuse

# Time zone of subscription dates and the nightly expiry (Europe/Moscow for Moscow time).
PORTAL_TIME_ZONE=Asia/Ho_Chi_Minh

# Port on 127.0.0.1 that Caddy proxies to.
APP_PORT=18081

# First start only: creates the teacher's administrator account (password at least 10 characters).
# After the log says "Administrator account created", clear ADMIN_BOOTSTRAP_PASSWORD and run the up command again.
ADMIN_BOOTSTRAP_LOGIN=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Эмир
